# Copy this file to tuganire.env and fill in your values

# Database Configuration
DB_URL=jdbc:postgresql://db:5432/tuganire
DB_USERNAME=tuganire_user
DB_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# JWT Configuration
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET_KEY
JWT_EXPIRY_HOURS=24

# Hibernate Configuration
# Use 'update' for development, 'validate' for production
HIBERNATE_HBM2DDL_AUTO=update

# PostgreSQL Configuration
POSTGRES_DB=tuganire
POSTGRES_USER=tuganire_user
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD
